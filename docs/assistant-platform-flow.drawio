        <mxCell id="flows" value="Flussi chiave&#xa;&#xa;1. Login / signup&#xa;owner -&gt; web -&gt; Supabase Auth -&gt; sync app_user su assistant-core&#xa;&#xa;2. Onboarding tenant&#xa;web -&gt; /api/onboarding/mock -&gt; tenant + membership owner + channel instance&#xa;&#xa;3. WhatsApp pairing&#xa;web -&gt; assistant-core -&gt; evolution-api -&gt; Baileys / WhatsApp&#xa;&#xa;4. Google Calendar&#xa;web -&gt; assistant-core -&gt; Google OAuth -&gt; callback -&gt; calendar credentials&#xa;&#xa;5. Runtime conversazione&#xa;customer -&gt; WhatsApp -&gt; evolution webhook -&gt; assistant-core -&gt; LLM / calendar -&gt; evolution -&gt; customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1490" y="540" width="500" height="360" as="geometry" />
        </mxCell>

