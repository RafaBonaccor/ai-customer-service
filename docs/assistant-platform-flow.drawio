  <diagram id="assistant-platform-flow" name="Assistant Platform Flow">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AI Secretary Architecture Map&#xa;componenti, flussi, chiamate e tooling operativo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1f1a17;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="60" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legenda flussi&#xa;&#xa;Blu = autenticazione utente + onboarding&#xa;Verde = runtime messaggi WhatsApp&#xa;Arancione = Google OAuth + Calendar&#xa;Viola = tooling / deploy / runtime operativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1600" y="40" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="owner" value="Business Owner / Admin&#xa;&#xa;- registra account&#xa;- fa onboarding&#xa;- collega WhatsApp&#xa;- collega Google Calendar" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="web" value="ai-secretary-web&#xa;Next.js frontend + BFF routes&#xa;&#xa;- /login / signup&#xa;- /onboarding&#xa;- /api/* proxy verso assistant-core&#xa;- Supabase session nel browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="380" height="180" as="geometry" />
        </mxCell>

        <mxCell id="supabase" value="Supabase Auth&#xa;&#xa;- email/password&#xa;- Google social login&#xa;- session token client-side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="110" width="250" height="160" as="geometry" />
        </mxCell>

        <mxCell id="core" value="assistant-core&#xa;Spring Boot product backend&#xa;&#xa;- app_users + tenant_user_memberships&#xa;- tenants / subscriptions / channel_instances&#xa;- AI profiles + prompt orchestration&#xa;- intent detection + availability domain&#xa;- Google OAuth + credential store&#xa;- WhatsApp provider router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="390" width="500" height="250" as="geometry" />
        </mxCell>

        <mxCell id="coredb" value="Assistant data store&#xa;Postgres / Supabase DB&#xa;&#xa;- tenants&#xa;- channel_instances&#xa;- app_users&#xa;- memberships&#xa;- calendar domain&#xa;- google credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="110" y="430" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="LLM provider&#xa;OpenAI / chatmock&#xa;&#xa;- chat completions&#xa;- prompt + tool context&#xa;- reply draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="120" y="690" width="270" height="150" as="geometry" />
